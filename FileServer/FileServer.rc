#include "resource.h"
#include "afxres.h"
#include <commctrl.h>
#include "verrsrc.h"

LANGUAGE LANG_VIETNAMESE, SUBLANG_VIETNAMESE_VIETNAM

IDD_FILESERVER_DIALOG DIALOGEX 0, 0, 535, 310
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_CLIPCHILDREN
CAPTION "FileServer V8.6.6 - File Sync"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "Port:", -1, 8, 10, 24, 12
    EDITTEXT        IDC_EDIT_PORT, 36, 8, 47, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Token:", -1, 92, 10, 30, 12
    EDITTEXT        IDC_EDIT_TOKEN, 125, 8, 117, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Start", IDC_BTN_START, 250, 8, 52, 14
    PUSHBUTTON      "Stop", IDC_BTN_STOP, 307, 8, 52, 14
    LTEXT           "Max clients:", -1, 364, 10, 62, 12
    EDITTEXT        IDC_EDIT_MAX_CLIENTS, 431, 8, 44, 14, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP

    LTEXT           "Root:", -1, 8, 30, 24, 12
    EDITTEXT        IDC_EDIT_ROOT, 36, 28, 263, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_BTN_BROWSE, 305, 28, 52, 14
    LTEXT           "Active files:", -1, 363, 30, 72, 12
    EDITTEXT        IDC_EDIT_ACTIVE_TRANSFERS, 440, 28, 43, 14, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP

    LTEXT           "Files:", -1, 8, 50, 32, 12
    CONTROL         "XML", IDC_CHECK_FILTER_XML, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 41, 48, 43, 14
    CONTROL         "JSON", IDC_CHECK_FILTER_JSON, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 85, 48, 46, 14
    CONTROL         "RAW", IDC_CHECK_FILTER_RAW, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 132, 48, 43, 14
    CONTROL         "INI", IDC_CHECK_FILTER_INI, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 176, 48, 40, 14
    CONTROL         "RTF", IDC_CHECK_FILTER_RTF, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 217, 48, 42, 14
    CONTROL         "Other", IDC_CHECK_FILTER_OTHER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 260, 48, 51, 14
    EDITTEXT        IDC_EDIT_FILTER, 312, 48, 68, 14, ES_AUTOHSCROLL
    CONTROL         "All (*)", IDC_CHECK_FILTER_ALL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 384, 48, 56, 14
    CONTROL         "Schedule", IDC_CHECK_SCHEDULE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 443, 48, 84, 14

    LTEXT           "Start:", -1, 8, 70, 34, 12
    CONTROL         "", IDC_DTP_START_DATE, "SysDateTimePick32", DTS_SHORTDATEFORMAT | WS_TABSTOP, 45, 67, 94, 17
    CONTROL         "", IDC_DTP_START_TIME, "SysDateTimePick32", DTS_TIMEFORMAT | DTS_UPDOWN | WS_TABSTOP, 143, 67, 76, 17
    LTEXT           "End:", -1, 228, 70, 28, 12
    CONTROL         "", IDC_DTP_END_DATE, "SysDateTimePick32", DTS_SHORTDATEFORMAT | WS_TABSTOP, 258, 67, 94, 17
    CONTROL         "", IDC_DTP_END_TIME, "SysDateTimePick32", DTS_TIMEFORMAT | DTS_UPDOWN | WS_TABSTOP, 356, 67, 76, 17

    LTEXT           "Clients (double-click HostKey):", IDC_STATIC_CLIENTS_HEADER, 8, 89, 250, 12
    CONTROL         "", IDC_LIST_CLIENTS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 8, 103, 251, 80
    LTEXT           "Tree (double-click: Server folder):", IDC_STATIC_TREE_HEADER, 266, 89, 261, 12
    CONTROL         "", IDC_TREE_FILES, "SysTreeView32", TVS_HASLINES | TVS_HASBUTTONS | TVS_LINESATROOT | WS_BORDER | WS_TABSTOP, 266, 103, 261, 80
    LTEXT           "Processed: 0 / 0 files (0%)", IDC_STATIC_PROGRESS, 8, 189, 519, 12
    CONTROL         "", IDC_PROGRESS_FILES, "msctls_progress32", PBS_SMOOTH | WS_BORDER, 8, 204, 519, 14
    LTEXT           "Updated: 0   Unchanged: 0   Active: 0   Pending: 0   Failed: 0", IDC_STATIC_PROGRESS_DETAIL, 8, 222, 519, 12
    LTEXT           "Log:", IDC_STATIC_LOG_HEADER, 8, 240, 50, 12
    LISTBOX         IDC_LIST_LOG, 8, 253, 519, 36, LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Status: Idle", IDC_STATIC_STATUS, 8, 294, 519, 12
END

STRINGTABLE
BEGIN
    IDR_MAINFRAME           "FileServer"
END
